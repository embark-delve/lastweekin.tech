<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LastWeekIn.Tech</title>
    <link rel="stylesheet" href="style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Titillium+Web:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <h1>LastWeekIn.Tech</h1>
        <p>The top 7 tech stories of the week ending {{ week }}</p>
    </header>
    <main>
        <div class="story-list">
            {% for story in stories %}
            <div class="story-card">
                <div class="story-rank">{{ story.rank }}</div>
                <div class="story-content">
                    <h2><a href="{{ story.url }}" target="_blank">{{ story.title }}</a></h2>
                    <div class="story-meta">
                        <span class="story-source">{{ story.source }}</span>
                        <span class="story-category">{{ story.category }}</span>
                    </div>
                    <p class="story-summary">{{ story.summary }}</p>
                </div>
            </div>
            {% endfor %}
        </div>
    </main>
    <footer>
        <p>Generated by LastWeekIn.Tech</p>
    </footer>
</body>
</html>