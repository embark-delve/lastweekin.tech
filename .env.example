# Copy to .env and fill in. The pipeline reads these from the environment;
# config.yaml refers to them as ${VAR}.

# Required. Used for the primary summarization model and its OpenRouter
# fallbacks. Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Only needed for the Hugging Face fallback models listed under
# summarizer.huggingface_models in config.yaml. Leave blank to skip them.
HF_TOKEN=

# Optional. Enables the weekly consensus check against the wider press
# (config.yaml, `perplexity`). Leave blank to skip that stage.
PERPLEXITY_API_KEY=
